# than ignored, which is one `git add -A` away from being published.
docs/LAUNCH_KIT.md
docs/promo/

# App Store screenshots — generated by scripts/appstore-screenshots.sh, never committed
docs/appstore/

# Release artifacts (CI builds into dist/ too; nothing in it belongs in git)
dist/
